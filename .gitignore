# Godot 4+ specific ignores
.godot/
/android/
.import/

# Exported builds. The web export alone is a ~38 MB .wasm and a ~17 MB .pck,
# and the Android APK is tens of megabytes more - all rewritten from scratch on
# every export, so committing them would grow the repo by that much per rebuild
# and never let go of any of it. Vercel is deployed with `npx vercel` from
# builds/mendigo-web, which uploads the folder directly, and the APK is handed
# round as a file. Neither needs to be in git.
/builds/
/bin/
